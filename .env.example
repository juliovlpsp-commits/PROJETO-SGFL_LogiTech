# Copie para .env e substitua cada valor antes de subir o ambiente.
POSTGRES_DB=sgfl_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
POSTGRES_HOST_PORT=5433
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Opcional. O Redis não publica porta no host; defina senha em ambientes compartilhados.
REDIS_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

# Para criar o primeiro administrador, habilite e preencha os campos abaixo.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

APP_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Opcionais — descomente e preencha conforme a necessidade.

# Modo de baixa de estoque dos pedidos: IMEDIATA (padrão) ou RESERVA.
# Em RESERVA a baixa física acontece na conclusão do pedido (despacho).
#SGFL_STOCK_MODE=IMEDIATA

# Avisos por e-mail (SMTP) em mudanças de status da entrega.
# Sem SGFL_MAIL_ENABLED=true e SGFL_MAIL_HOST o envio fica desligado.
#SGFL_MAIL_ENABLED=false
#SGFL_MAIL_HOST=smtp.seudominio.com
#SGFL_MAIL_PORT=587
#SGFL_MAIL_USERNAME=
#SGFL_MAIL_PASSWORD=
#SGFL_MAIL_FROM=noreply@seudominio.com
#SGFL_MAIL_TO=logistica@seudominio.com
#SGFL_MAIL_STARTTLS=true
#SGFL_PUBLIC_URL=https://painel.seudominio.com

# Geocodificação e rota (padrões gratuitos, sem chave: Nominatim/OSRM).
#SGFL_GEOCODER_URL=https://nominatim.openstreetmap.org
#SGFL_ROUTER_URL=https://router.project-osrm.org
#SGFL_ETA_AVG_SPEED_KMH=50

# Provedor de rota: OSRM (padrão, sem chave) ou TOMTOM (trânsito em tempo
# real; crie uma chave gratuita em developer.tomtom.com e preencha abaixo).
#SGFL_ROUTER_PROVIDER=OSRM
#SGFL_ROUTER_API_KEY=

# Avisos de status por WhatsApp via gateway HTTP no contrato
# {"to", "from", "message"} (n8n, ponte própria ou provedor genérico).
# Sem SGFL_WHATSAPP_ENABLED=true e SGFL_WHATSAPP_API_URL o envio fica
# desligado. SGFL_WHATSAPP_TO aceita números separados por vírgula
# ("11999998888" ou "+5511999998888").
#SGFL_WHATSAPP_ENABLED=false
#SGFL_WHATSAPP_API_URL=https://seu-gateway.exemplo/webhook
#SGFL_WHATSAPP_TOKEN=
#SGFL_WHATSAPP_FROM=SGFL
#SGFL_WHATSAPP_TO=
