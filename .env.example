# Copie para .env e substitua cada valor antes de subir o ambiente.
POSTGRES_DB=sgfl_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Opcional. O Redis não publica porta no host; defina senha em ambientes compartilhados.
REDIS_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

# Para criar o primeiro administrador, habilite e preencha os campos abaixo.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

APP_COOKIE_SECURE=false
