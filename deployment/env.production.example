# Copie para deployment/.env.production e preencha usando os segredos da plataforma.
# Nunca versione o arquivo preenchido.
DB_URL=jdbc:postgresql://HOST:5432/sgfl_db?sslmode=require
DB_USERNAME=sgfl_app
DB_PASSWORD=SUBSTITUA_NO_COFRE_DE_SEGREDOS
DB_POOL_SIZE=10

JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=86400000

REDIS_HOST=HOST_DO_REDIS
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUA_NO_COFRE_DE_SEGREDOS
REDIS_SSL_ENABLED=true

# Porta HTTP local do container; publique somente por trás de HTTPS/TLS.
SGFL_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=https://sgfl.suaempresa.com

# Habilite apenas no primeiro boot e remova a senha após criar o administrador.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
